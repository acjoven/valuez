# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# Packaging / build artifacts
build/
dist/
*.egg-info/

# Environments
.venv/
venv/
.env

# OS
.DS_Store

# Local scratch data
data/_scratch/

# Local expanded dots stores / rehydrated caches.
